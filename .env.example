# Copy this file to .env (gitignored) and fill it in. Never commit .env.

# Path to the pinned Stockfish binary (brew install stockfish && brew pin stockfish).
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# Sent in the User-Agent to chess.com so they can reach you about API use.
CHESSCOM_CONTACT_EMAIL=

# Lichess personal API token with no scopes ticked, used only by the pipeline
# for the opening explorer (Phase 2): https://lichess.org/account/oauth/token/create
LICHESS_TOKEN=

# AI-worded coach notes (Phase 6, optional) need no key here: they use an `ant auth login`
# profile locally and Workload Identity Federation in the nightly Action (docs/PLAN.md).
